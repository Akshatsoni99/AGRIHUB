# Supabase Configuration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key safe for browser usage with RLS enabled
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps Platform Configuration
# Browser key restricted by HTTP referrer to Maps JavaScript API & Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-side only key restricted to Google Routes API (never exposed to browser)
GOOGLE_MAPS_ROUTES_API_KEY=

